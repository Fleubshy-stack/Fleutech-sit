{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/includes(?:/.*)?$",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/$",
      "dest": "/index.php"
    },
    {
      "src": "^/service$",
      "dest": "/service.php"
    },
    {
      "src": "^/solution$",
      "dest": "/solution.php"
    },
    {
      "src": "^/stack-tech$",
      "dest": "/stack-tech.php"
    },
    {
      "src": "^/blog$",
      "dest": "/blog.php"
    },
    {
      "src": "^/avis$",
      "dest": "/avis.php"
    },
    {
      "src": "^/contact$",
      "dest": "/contact.php"
    },
    {
      "src": "^/conference-ia$",
      "dest": "/conference-ia.php"
    },
    {
      "src": "^/statistiques$",
      "dest": "/statistiques.php"
    }
  ]
}
